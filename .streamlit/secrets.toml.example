# ── NSE Algo Trader — Streamlit Cloud Secrets ─────────────────────────────────
# Copy this file's content into Streamlit Cloud → App settings → Secrets
# (do NOT commit actual credentials to git)

# Fyers broker credentials
FYERS_APP_ID     = "YOUR_FYERS_APP_ID"        # e.g. "0R8OIQNU9K-200"
FYERS_SECRET     = "YOUR_FYERS_SECRET"
FYERS_REDIRECT_URI = "https://your-app.streamlit.app/"

# PostgreSQL / TimescaleDB (optional — dashboard degrades gracefully without it)
DATABASE_URL = "postgresql://user:password@host:5432/nse_algo"

# Telegram alerts (optional)
TELEGRAM_TOKEN  = "YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID = "YOUR_CHAT_ID"

# Redis (optional — used for event bus in live trading mode)
REDIS_URL = "redis://localhost:6379"
